<article class="bento-tile col-span-1 md:col-span-3 min-h-[60vh] flex flex-col overflow-hidden relative group">
    
    <!-- Background glow elements -->
    <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjAiIGhlaWdodD0iMjAiIHhtbG5zPSJodHRwOi8vd3d3LnczLm9yZy8yMDAwL3N2ZyI+PHBhdGggZD0iTTEgMWgyMHYyMEgxVjF6IiBmaWxsPSJub25lIiBzdHJva2U9InJnYmEoMjEyLCAxNzUsIDU1LCAwLjAzKSIgc3Ryb2tlLXdpZHRoPSIxIi8+PC9zdmc+')] opacity-50 z-0"></div>

    <div class="bento-header sticky top-0 bg-[#1A0F0F]/90 backdrop-blur z-20 shadow-sm border-b border-sanctum-accent/20">
        <a href="/" class="text-sanctum-text/60 hover:text-sanctum-accent text-xs uppercase tracking-widest flex items-center gap-2 transition-all font-bold">
            <div class="w-6 h-6 rounded-full bg-sanctum-bg border border-sanctum-accent/30 flex items-center justify-center group-hover:bg-sanctum-accent/10 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
            </div>
            Return to Sanctum
        </a>
        <div class="technical text-sanctum-text/50 text-[10px]">THE_SCRIPTORIUM</div>
    </div>
    
    <div class="relative z-10 flex-1 w-full text-sanctum-text/70 min-h-[50vh] p-8 md:p-12 lg:p-16">
        <header class="text-center mb-16">
            <h1 class="font-serif text-4xl md:text-6xl text-sanctum-accent mb-4 tracking-widest uppercase">The Scriptorium</h1>
            <div class="h-[1px] w-24 bg-sanctum-accent mx-auto mb-4 opacity-50"></div>
            <p class="font-mono text-xs tracking-widest text-[#B5935B]/60 uppercase">Laboratory Notes & Catalogs</p>
        </header>

        <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            <% subjects.forEach(function(sub) { %>
                <!-- <%= sub.name %> Card -->
                <a href="/resources/<%= sub.slug %>" class="bento-tile hover:scale-[1.02] active:scale-[0.98] transition-all duration-300 flex flex-col justify-between group/card bg-[#1A0F0F]/45 border border-sanctum-accent/20 rounded-xl p-6 min-h-[220px]">
                    <div>
                        <div class="flex items-center justify-between mb-4 border-b border-sanctum-accent/10 pb-3">
                            <div class="w-10 h-10 border border-sanctum-accent/40 flex items-center justify-center text-sanctum-accent font-serif text-xl rounded-lg group-hover/card:border-sanctum-accent group-hover/card:bg-sanctum-accent/10 transition-all duration-300">
                                <%= sub.glyph %>
                            </div>
                            <span class="metadata text-[9px] text-sanctum-accent/40 group-hover/card:text-sanctum-accent/70 transition-colors uppercase font-mono tracking-widest"><%= sub.slug.replace('-', '_') %> // dir</span>
                        </div>
                        
                        <h2 class="font-serif text-xl tracking-widest uppercase text-[#F4F1EA] group-hover/card:text-sanctum-accent transition-colors mb-2">
                            <%= sub.name %>
                        </h2>
                        
                        <p class="font-sans text-xs text-sanctum-text/60 line-clamp-3 leading-relaxed mb-4">
                            <%= sub.description %>
                        </p>
                    </div>
                    
                    <div class="flex items-center justify-between border-t border-sanctum-accent/10 pt-3 text-[10px] font-mono tracking-wider text-sanctum-accent/60 group-hover/card:text-sanctum-accent transition-colors">
                        <span class="uppercase"><%= sub.resources.length %> Documents</span>
                        <span class="flex items-center gap-1 font-bold">
                            ENTER ARCHIVE 
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 transform group-hover/card:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                            </svg>
                        </span>
                    </div>
                </a>
            <% }); %>
        </div>
    </div>
</article>
