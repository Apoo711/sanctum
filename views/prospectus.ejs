<link rel="stylesheet" type="text/css" href="/css/prospectus-page.css?v=1.1.5">

<div class="prospectus-page-layout">
    
    <!-- LEFT PANEL: ABOUT & COMMUNICATIONS -->
    <div class="prospectus-about-panel">
        <div class="prospectus-bio-content">
            <h1 class="prospectus-about-title">Aryan Gupta</h1>
            <div class="prospectus-about-subtitle">SCHOLAR // ASPIRING QUANT // DEVELOPER</div>
            
            <p class="prospectus-about-text">
                Welcome to the digital Sanctum. I am a Year 12 scholar aspiring to pursue a double degree in Actuarial Studies and Computer Science at UNSW, with the ultimate goal of transitioning into quantitative trading. While I occasionally write software in my leisure, my primary repository of projects can be explored via the GitHub ledger linked below. You are most welcome to connect with me on LinkedIn.
            </p>
            <p class="prospectus-about-text">
                Additionally, I curate and share VCE resources to support fellow students in their academic journeys. To the right, you will find my systems engineering project, VISOR, alongside my &ldquo;expedition logs&rdquo; &mdash; documenting volunteering initiatives in Cambodia and Vietnam.
            </p>
        </div>
        
        <!-- COMMUNICATION SIGILS -->
        <div class="prospectus-sigils-section">
            <h3 class="prospectus-sigils-title">Communication Sigils</h3>
            <div class="prospectus-sigils-grid">
                <!-- GITHUB -->
                <a href="https://github.com/Apoo711" target="_blank" rel="noopener noreferrer" class="sigil-link" aria-label="GitHub Codex">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-github"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
                    <span class="sigil-label">Github</span>
                </a>
                
                <!-- LINKEDIN -->
                <a href="https://www.linkedin.com/in/aryangupta-au/" target="_blank" rel="noopener noreferrer" class="sigil-link" aria-label="LinkedIn Ledger">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-linkedin"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
                    <span class="sigil-label">LinkedIn</span>
                </a>
                
                <!-- X / TWITTER -->
                <a href="https://x.com" target="_blank" rel="noopener noreferrer" class="sigil-link" aria-label="Twitter Codex">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-twitter"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"/></svg>
                    <span class="sigil-label">Twitter</span>
                </a>
                
                <!-- EMAIL -->
                <a href="mailto:<%= locals.email || '' %>" class="sigil-link" aria-label="Direct Dispatch">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-mail"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                    <span class="sigil-label">Email</span>
                </a>
            </div>
        </div>
    </div>
    
    <!-- RIGHT PANEL: SCHOLAR'S DESK -->
    <div class="prospectus-desk-panel">
        
        <!-- Re-use id="prospectus-modal" class="prospectus-standalone" for existing selectors -->
        <div id="prospectus-modal" class="prospectus-standalone">
            
            <h2 class="prospectus-title">The Scholar's Desk</h2>
            <div class="prospectus-rule"></div>
            <p class="prospectus-hint">Click a volume to open it &mdash; use arrows to turn pages</p>
            
            <!-- Desk layout: lists the booklets -->
            <div class="prospectus-desk" id="prospectus-desk">
                <%- include('booklet-modal') %>
            </div>
            
            <!-- Reading Navigation Controls -->
            <div id="reading-controls" class="reading-controls">
                <button class="reading-close-btn" id="reading-close-btn" onclick="closeBook()" aria-label="Close book">
                    &larr;&nbsp; Close Book
                </button>
                <div class="reading-nav">
                    <button class="reading-nav-btn" id="read-prev-btn" aria-label="Previous page">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
                    </button>
                    <div style="width: 40px;"></div> <!-- Spacer -->
                    <button class="reading-nav-btn" id="read-next-btn" aria-label="Next page">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                    </button>
                </div>
            </div>
            
        </div>
        
    </div>
    
</div>
