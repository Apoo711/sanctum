<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-8 auto-rows-[280px]">
    
    <!-- TILE: THE ORRERY (2x2) -->
    <div class="bento-tile col-span-1 md:col-span-2 row-span-2">
        <div class="bento-header">
            <h2><span class="status-dot"></span>THE ORRERY</h2>
            <span class="metadata">PHYSICS ENGINE</span>
        </div>
        <div class="flex-1 relative flex items-center justify-center">
            <canvas id="orrery" class="w-full h-full cursor-crosshair"></canvas>
            <!-- Background Axes -->
            <div class="absolute inset-0 flex items-center justify-center pointer-events-none opacity-5">
                <div class="w-full h-[1px] bg-white"></div>
                <div class="h-full w-[1px] bg-white absolute"></div>
            </div>
        </div>
        <div class="absolute bottom-6 right-6 metadata opacity-40">
            R.A. 14h 29m 43s | Dec −62° 40′ 46″
        </div>
    </div>

    <!-- TILE: THE DAILY LEDGER -->
    <div class="bento-tile">
        <div class="bento-header">
            <h2>THE LEDGER</h2>
            <span class="metadata">DAILY_MAXIM</span>
        </div>
        <div class="flex-1 flex flex-col justify-center p-4">
            <p id="ledger-quote-text" class="font-serif italic text-[15px] md:text-base text-center text-[#F4F1EA]/85 leading-relaxed my-auto">
                "<%= quote.text %>"
            </p>
            <div class="text-right mt-4 pt-2 border-t border-sanctum-accent/10">
                <span id="ledger-quote-author" class="metadata font-bold text-sanctum-accent/80">&mdash; <%= quote.author %></span>
            </div>
        </div>
    </div>

    <!-- TILE: TACTICS (CHESS) -->
    <div class="bento-tile">
        <div class="bento-header">
            <h2>TACTICS</h2>
            <div class="flex gap-2" role="radiogroup" aria-label="Chess Tactics Mode">
                <button class="mode-btn active" data-mode="BULLET" role="radio" aria-checked="true">BULLET</button>
                <button class="mode-btn" data-mode="BLITZ" role="radio" aria-checked="false">BLITZ</button>
                <button class="mode-btn" data-mode="RAPID" role="radio" aria-checked="false">RAPID</button>
            </div>
        </div>
        <div class="flex-1 flex flex-col items-center justify-center">
            <!-- Chess.com Bullet Icon SVG (Default) -->
            <div class="w-16 h-16 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                <svg viewBox="0 0 100 100" class="w-full h-full" fill="none" stroke="#B5935B" stroke-width="3">
                    <path d="M30 60 Q50 10 70 60 L70 90 L30 90 Z" fill="#B5935B" fill-opacity="0.1"/>
                    <path d="M30 75 H70 M30 85 H70" stroke-opacity="0.5"/>
                </svg>
            </div>
            <div id="chess-rating" class="text-4xl font-serif mb-1">...</div>
            <div id="chess-label" class="metadata text-[9px] opacity-60 uppercase">BULLET RATING // ARYAN18GUPTA</div>
        </div>
    </div>

    <!-- TILE: THE PHONOGRAPH (YOUTUBE MUSIC INTEGRATION) -->
    <div class="bento-tile col-span-1 md:col-span-3">
        <div class="bento-header">
            <h2>THE PHONOGRAPH</h2>
            <span class="metadata">RECENTLY_PLAYED</span>
        </div>
        <div class="h-48 rounded-lg bg-[#020202] border border-sanctum-accent/15 shadow-inner flex overflow-hidden relative group/music">
            <!-- Left Side: Spinning Vinyl / Audio Wave Visualizer -->
            <div class="w-32 md:w-48 h-full bg-[#020202] flex items-center justify-center relative overflow-hidden border-r border-sanctum-accent/10">
                <!-- Vinyl Disc Placeholder -->
                <div id="music-vinyl-container" class="relative w-24 h-24 md:w-32 md:h-32 flex items-center justify-center">
                    <!-- Spinning Vinyl Record -->
                    <div id="music-vinyl" class="w-20 h-20 md:w-28 md:h-28 rounded-full bg-gradient-to-tr from-[#121212] via-[#282828] to-[#121212] shadow-2xl flex items-center justify-center border border-white/5 relative transition-all duration-[1500ms]">
                        <!-- Vinyl Grooves -->
                        <div class="absolute inset-1 md:inset-2 rounded-full border border-black/20"></div>
                        <div class="absolute inset-2.5 md:inset-4 rounded-full border border-black/35"></div>
                        <div class="absolute inset-4 md:inset-6 rounded-full border border-black/50"></div>
                        <div class="absolute inset-5.5 md:inset-8 rounded-full border border-black/60"></div>
                        
                        <!-- Vinyl Album Art Center -->
                        <div id="music-cover" class="w-8 h-8 md:w-12 md:h-12 rounded-full bg-cover bg-center border border-black/50 overflow-hidden z-10 flex items-center justify-center bg-zinc-800 transition-all duration-[1000ms]">
                            <!-- Default music symbol -->
                            <svg id="music-default-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#B5935B" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-music"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
                        </div>
                        
                        <!-- Center Spindle Hole (absolute to prevent pushing the cover off-center) -->
                        <div class="w-1.5 h-1.5 md:w-2.5 md:h-2.5 rounded-full bg-[#020202] border border-white/10 z-20 shadow-inner absolute"></div>
                    </div>
                    
                    <!-- Stylus/Tonearm (Swings over when playing) -->
                    <div id="music-tonearm" class="absolute top-1 right-1 w-8 h-12 md:top-2 md:right-2 md:w-10 md:h-16 origin-[top_right] rotate-[-25deg] transition-transform duration-[1000ms] ease-out pointer-events-none">
                        <svg viewBox="0 0 40 80" class="w-full h-full" fill="none" stroke="#B5935B" stroke-width="2">
                            <!-- Pivot Base -->
                            <circle cx="30" cy="15" r="8" fill="#121212" stroke="#B5935B" stroke-width="1"/>
                            <!-- Arm Shaft -->
                            <path d="M30 15 L15 50 L18 70" stroke-linecap="round"/>
                            <!-- Head Shell / Cartridge -->
                            <rect x="12" y="66" width="10" height="6" rx="1" fill="#B5935B"/>
                        </svg>
                    </div>
                </div>
            </div>

            <!-- Right Side: Track Metadata (Matching UI Elegance) -->
            <div class="flex-1 p-6 flex flex-col justify-between relative overflow-hidden bg-gradient-to-r from-[#020202] to-[#0a0a0a]">
                <div class="flex flex-col gap-1">
                    <div class="flex items-center gap-2">
                        <span id="music-status-dot" class="w-2 h-2 rounded-full bg-zinc-600 animate-pulse"></span>
                        <span id="music-status-text" class="metadata text-[10px] tracking-[0.2em] uppercase text-zinc-500 font-bold">DISCONNECTED</span>
                    </div>
                    <div class="mt-2 w-full overflow-hidden">
                        <div class="w-full overflow-hidden">
                            <h3 id="music-title" class="text-xl font-serif text-[#F4F1EA] tracking-wide whitespace-nowrap inline-block">Offline</h3>
                        </div>
                        <p id="music-artist" class="text-sm text-sanctum-accent/80 font-mono mt-1 tracking-wider line-clamp-1">No service running</p>
                    </div>
                </div>
                
                <div class="flex items-center justify-between border-t border-sanctum-accent/10 pt-3">
                    <span id="music-album" class="text-[10px] font-serif uppercase tracking-widest text-[#F4F1EA]/40 line-clamp-1 max-w-[70%]">
                        SYSTEM STANDBY
                    </span>
                    <a id="music-link" href="#" target="_blank" class="text-[10px] font-mono text-sanctum-accent hover:text-[#F4F1EA] transition-colors flex items-center gap-1 opacity-0 pointer-events-none">
                        LISTEN <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>